{
  "expo": {
    "name": "SciX",
    "slug": "ScistraCommunityApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/scix.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/scix.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xcience.scix",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SciX uses the camera so you can take photos to attach to posts and share in chats. For example, you can take a photo and add it to a community post or send it in a direct message.",
        "NSPhotoLibraryUsageDescription": "SciX uses your photo library so you can choose photos to attach to posts, send in chats, or set as your profile picture. For example, you can select a photo from your gallery to add to a community post or to use as your profile photo."
      },
      "buildNumber": "10"
    },
    "android": {
      "package": "com.sciastra.scix",
      "versionCode": 39,
      "adaptiveIcon": {
        "foregroundImage": "./assets/scix.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/scix.png"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "requestLegacyExternalStorage": true
          }
        }
      ],
      "./plugins/android-network-security.js",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "1b269736-133a-4424-890d-305ff14cfbf6"
      }
    }
  }
}
